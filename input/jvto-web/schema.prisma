generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model activities {
  id                            BigInt                          @id @default(autoincrement())
  code                          String?
  activity_category_id          BigInt?
  activity_name                 String
  destination_id                BigInt?
  created_at                    DateTime?                       @db.Timestamp(6)
  updated_at                    DateTime?                       @db.Timestamp(6)
  deleted_at                    DateTime?                       @db.Timestamp(6)
  estimated_time                String?                         @db.VarChar(100)
  slug                          String?                         @db.VarChar(100)
  activity_categories           activity_categories?            @relation(fields: [activity_category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_activities_activity_category_id")
  destinations                  destinations?                   @relation(fields: [destination_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_activities_destination_id")
  package_itinerary_day_details package_itinerary_day_details[]
}

model activity_categories {
  id         BigInt       @id @default(autoincrement())
  name       String?
  icon       String?
  created_at DateTime?    @db.Timestamp(6)
  updated_at DateTime?    @db.Timestamp(6)
  deleted_at DateTime?    @db.Timestamp(6)
  activities activities[]
}

model activity_ends {
  id                     BigInt                   @id @default(autoincrement())
  name                   String
  description            String
  destination_id         BigInt?
  dinner                 Boolean?                 @default(false)
  created_at             DateTime?                @db.Timestamp(6)
  updated_at             DateTime?                @db.Timestamp(6)
  deleted_at             DateTime?                @db.Timestamp(6)
  destinations           destinations?            @relation(fields: [destination_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_activity_ends_destination_id")
  booking_itineraries    booking_itineraries[]
  package_itinerary_days package_itinerary_days[]
}

model activity_starts {
  id                                                           BigInt                   @id @default(autoincrement())
  name                                                         String
  description                                                  String
  destination_id                                               BigInt?
  breakfast                                                    Boolean?                 @default(false)
  lunch                                                        Boolean?                 @default(false)
  created_at                                                   DateTime?                @db.Timestamp(6)
  updated_at                                                   DateTime?                @db.Timestamp(6)
  deleted_at                                                   DateTime?                @db.Timestamp(6)
  id_name_description_destination_id_b_l_created_at_updated_at String?                  @map("id;name;description;destination_id;b;l;created_at;updated_at") @db.VarChar(256)
  b                                                            Boolean?
  l                                                            Boolean?
  destinations                                                 destinations?            @relation(fields: [destination_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_activity_starts_destination_id")

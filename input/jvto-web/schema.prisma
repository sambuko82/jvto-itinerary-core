enum source_enum {
  UPLOAD
  LINK
}

enum asset_type {
  image
  video
  document
}

model folders {
  id         BigInt   @id @default(autoincrement())
  parent_id  BigInt? // FK ke folders.id
  name       String
  created_at DateTime @default(now())

  // RELATIONS
  parent   folders?  @relation("FolderToFolder", fields: [parent_id], references: [id])
  children folders[] @relation("FolderToFolder")

  assets assets[]

  @@index([parent_id], name: "idx_folders_parent_id")
}

model tags_assets {
  id   BigInt @id @default(autoincrement())
  name String @unique

  // relasi many-to-many ke assets lewat asset_tags
  assets asset_tags[]
}

model assets {
  id             BigInt     @id @default(autoincrement())
  folder_id      BigInt
  name           String
  caption        String?
  description    String?
  type           asset_type
  url            String
  file_ext       String?
  size_bytes     BigInt?
  size_megabytes Decimal?   @db.Decimal(12, 4)
  sha256         String?
  last_verified  DateTime?
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now())

  // RELATIONS
  folder folders      @relation(fields: [folder_id], references: [id])
  tags   asset_tags[]

  // NEW RELATION
  destination_assets destination_assets[]

  package_assets package_assets[]

  @@index([folder_id], name: "idx_assets_folder_id")
  @@index([is_active], name: "idx_assets_is_active")
  @@index([type], name: "idx_assets_type")
  @@index([created_at], name: "idx_assets_created_at")
  @@index([sha256], name: "idx_assets_sha256")
}

model asset_tags {
  asset_id BigInt
  tag_id   BigInt

  // RELATIONS
  asset assets      @relation(fields: [asset_id], references: [id])
  tag   tags_assets @relation(fields: [tag_id], references: [id])

  @@id([asset_id, tag_id])
  @@index([tag_id], name: "idx_asset_tags_tag_id")
  @@index([asset_id], name: "idx_asset_tags_asset_id")
}

enum destination_asset_type {
  primary
  secondary
}

model destination_assets {
  id             BigInt                 @id @default(autoincrement())
  destination_id BigInt
  asset_id       BigInt
  type           destination_asset_type
  created_at     DateTime               @default(now())
  updated_at     DateTime               @default(now())

  // RELATIONS
  destination destinations @relation(fields: [destination_id], references: [id])
  asset       assets       @relation(fields: [asset_id], references: [id])

  @@index([destination_id], name: "idx_destination_assets_destination_id")
  @@index([asset_id], name: "idx_destination_assets_asset_id")
  @@map("destination_assets")
}

model destination_faqs {
  id             BigInt @id @default(autoincrement())
  destination_id BigInt
  faq_id         BigInt

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // RELATIONS
  destination destinations @relation(fields: [destination_id], references: [id])
  faq         faqs         @relation(fields: [faq_id], references: [id])

  @@unique([destination_id, faq_id], map: "ux_destination_faqs_destination_faq")
  @@index([destination_id], map: "idx_destination_faqs_destination_id")
  @@index([faq_id], map: "idx_destination_faqs_faq_id")
  @@map("destination_faqs")
}

model eav_entity {
  entity_id   String @id @db.Uuid
  entity_type String @db.Text
  entity_key  String @unique @db.Text

  // Relations
  values             eav_value[]
  outgoing_relations eav_relation[] @relation("eav_relation_from_entity")
  incoming_relations eav_relation[] @relation("eav_relation_to_entity")

  @@index([entity_type])
}

model eav_attribute {
  attribute_id  String @id @db.Uuid
  attribute_key String @unique @db.Text
  value_type    String @db.Text

  // Relations
  values eav_value[]
}

model eav_value {
  value_id     String @id @db.Uuid
  entity_id    String @db.Uuid
  attribute_id String @db.Uuid

  // Typed value columns (sesuai yang dipakai di query render)
  value_string  String?   @db.Text
  value_text    String?   @db.Text
  value_url     String?   @db.Text
  value_json    Json?     @db.JsonB
  value_boolean Boolean?
  value_date    DateTime? @db.Date

  lang       String  @db.Text
  source_ref String? @db.Text

  // Relations
  entity    eav_entity    @relation(fields: [entity_id], references: [entity_id], onDelete: Cascade)
  attribute eav_attribute @relation(fields: [attribute_id], references: [attribute_id], onDelete: Cascade)

  @@unique([entity_id, attribute_id, lang])
  @@index([entity_id])
  @@index([attribute_id])
  @@index([lang])
}

model eav_relation {
  relation_id    String @id @db.Uuid
  from_entity_id String @db.Uuid
  rel_type       String @db.Text
  to_entity_id   String @db.Uuid
  ord            Int?

  from_entity eav_entity @relation("eav_relation_from_entity", fields: [from_entity_id], references: [entity_id], onDelete: Cascade)
  to_entity   eav_entity @relation("eav_relation_to_entity", fields: [to_entity_id], references: [entity_id], onDelete: Cascade)

  @@unique([from_entity_id, rel_type, to_entity_id])
  @@index([from_entity_id, rel_type])
  @@index([to_entity_id, rel_type])
}

// ── narrative_claims (added 2026-04-29 as part of AEO/GEO port from rewrite repo) ───────
// 9 canonical narrative claims (C1–C9) wired to specific primary_page values. Used as the
// single source of truth for FAQPage JSON-LD across the entity graph (cluster_role_contracts.md).
// Field types match actual DB introspection: jsonb for mechanism / evidence_hooks / nlp_variants;
// text[] for evidence_slugs. Caller queries via src/lib/queries/narrativeClaims.ts.
model narrative_claims {
  id             String   @id @db.Text
  pillar         String?  @db.Text
  core_claim     String?  @db.Text
  mechanism      Json?
  evidence_hooks Json?
  nlp_variants   Json?
  evidence_slugs String[] @db.Text
  primary_page   String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([primary_page])
}
